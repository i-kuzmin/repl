#!/usr/bin/env ruby
# frozen_string_literal: true

# repl -- wrap a persistent REPL process and expose it over a UNIX socket.
#
#   repl kernel irb          # start a server (admin console on stdin/stdout)
#   echo 'a = [1,2,3]' | repl send
#
# Single-file implementation: everything lives in the Repl module so it can be
# unit tested by `load`ing this file.

require 'fileutils'
require 'json'
require 'open3'
require 'optparse'
require 'securerandom'
require 'socket'
require 'tmpdir'

module Repl
  VERSION = '1.0.0'

  DEFAULT_IDLE_TIMEOUT = 0.3   # silence that marks the end of an answer
  DEFAULT_WAIT_TIMEOUT = 2.0   # how long to wait for the first byte
  DEFAULT_TIMEOUT      = 30.0  # inactivity limit in prompt/marker mode
  DEFAULT_HISTORY      = 100
  MARKER_GRACE         = 0.05  # time given to trailing output after a marker
  POST_GRACE           = 0.2   # time given to the answer of a `post` nobody read

  # Control characters and friendly names accepted by `repl signal`.
  SIGNAL_ALIASES = {
    "\x03" => 'INT',  '^C' => 'INT',  'CTRL-C' => 'INT',  'C-C' => 'INT',
    "\x1A" => 'TSTP', '^Z' => 'TSTP', 'CTRL-Z' => 'TSTP', 'C-Z' => 'TSTP',
    "\x1C" => 'QUIT', '^\\' => 'QUIT', 'CTRL-\\' => 'QUIT',
    "\x04" => 'EOF',  '^D' => 'EOF',  'CTRL-D' => 'EOF',  'C-D' => 'EOF'
  }.freeze

  # Signals a terminal generates from a keystroke; they are aimed at the
  # foreground job rather than at the shell that started it.
  TERMINAL_SIGNALS = %w[INT QUIT TSTP].freeze

  class Error < StandardError; end

  # Wraps the REPL child process. Communication goes over plain pipes (not a
  # PTY) so that REPLs disable their line editors and emit clean output.
  class Backend
    attr_reader :command, :pid, :banner

    def initialize(command, idle_timeout: DEFAULT_IDLE_TIMEOUT,
                   wait_timeout: DEFAULT_WAIT_TIMEOUT, timeout: DEFAULT_TIMEOUT,
                   prompt: nil, marker: nil)
      @command = Array(command).map(&:to_s)
      raise Error, 'kernel command is required' if @command.empty?

      @idle_timeout = idle_timeout
      @wait_timeout = wait_timeout
      @timeout = timeout
      @prompt = prompt && Regexp.new(prompt)
      @marker = marker
      @echo = false # set once the kernel is seen echoing its input
      @posted = false # true while an unread answer of a `post` may be coming
      # Own process group, so that signals reach the kernel and its children
      # without touching the server itself.
      @stdin, @stdout, @waiter = Open3.popen2e({ 'TERM' => 'dumb' }, *@command, pgroup: true)
      @pid = @waiter.pid
      @banner = clean(sync_startup, '', nil)
    rescue Errno::ENOENT => e
      raise Error, "cannot start kernel: #{e.message}"
    end

    def alive?
      @waiter.alive?
    end

    # Send one command to the REPL and return its output.
    def execute(input)
      raise Error, 'kernel is not running' unless alive?

      command_text = input.to_s.sub(/\n+\z/, '')
      return '' if command_text.strip.empty?

      # A previous `post` may still be answering; give it time to arrive so
      # that its output is dropped here and not mixed into this answer.
      discard_pending(@posted ? POST_GRACE : 0)
      @posted = false
      token = @marker ? new_token : nil
      @stdin.puts(command_text)
      @stdin.puts(format(@marker, token)) if token
      @stdin.flush
      clean(read_answer(token), command_text, token)
    rescue Errno::EPIPE
      raise Error, 'kernel has terminated'
    end

    # Write a command to the kernel without reading its answer. Never waits
    # for output, so it also works while another command is running (it then
    # feeds that command's stdin).
    def post(input)
      raise Error, 'kernel is not running' unless alive?

      command_text = input.to_s.sub(/\n+\z/, '')
      return '' if command_text.strip.empty?

      @stdin.puts(command_text)
      @stdin.flush
      @posted = true
      command_text
    rescue Errno::EPIPE, IOError
      raise Error, 'kernel has terminated'
    end

    # Send a signal (or a control character such as "^C") to the kernel.
    # Never blocks, so it works while a command is still running.
    def signal(name)
      signal = self.class.normalize_signal(name)
      raise Error, 'kernel is not running' unless alive?

      if signal == 'EOF'
        close_input
        return 'EOF'
      end
      deliver(signal)
      signal
    end

    def self.normalize_signal(name)
      key = name.to_s.strip
      key = SIGNAL_ALIASES[key] || SIGNAL_ALIASES[key.upcase] || key.upcase
      key = key.sub(/\ASIG/, '')
      return key if key == 'EOF' || Signal.list.key?(key)

      raise Error, "unknown signal '#{name}'"
    end

    def close
      close_input
      @waiter.join(1) || (Process.kill('TERM', @pid) rescue nil)
      @waiter.join(1) || (Process.kill('KILL', @pid) rescue nil)
      @stdout.close unless @stdout.closed?
      nil
    rescue IOError, Errno::ESRCH
      nil
    end

    private

    # Terminal-generated signals go to the foreground job, i.e. to the
    # kernel's own children when it is running one. Shells (bash, sh, ...)
    # quit when a SIGINT of their own arrives, so hitting the whole process
    # group would kill the kernel instead of the command it is running.
    def deliver(signal)
      if TERMINAL_SIGNALS.include?(signal)
        job = descendants
        unless job.empty?
          job.each { |pid| Process.kill(signal, pid) rescue nil }
          return
        end
      end
      signal_group(signal)
    end

    # Signal the whole process group; fall back to the process itself.
    def signal_group(signal)
      Process.kill(signal, -@pid)
    rescue Errno::ESRCH, Errno::EPERM
      begin
        Process.kill(signal, @pid)
      rescue Errno::ESRCH
        raise Error, 'kernel is not running'
      end
    end

    # Every process below the kernel, children first.
    def descendants
      children = child_map
      found = []
      queue = [@pid]
      until queue.empty?
        children[queue.shift].to_a.each do |pid|
          next if found.include?(pid)

          found << pid
          queue << pid
        end
      end
      found
    end

    # pid => [child pid, ...] for every process on the machine.
    def child_map
      map = Hash.new { |h, k| h[k] = [] }
      each_process { |pid, ppid| map[ppid] << pid }
      map
    end

    def each_process
      if File.directory?('/proc/self')
        each_proc_process { |pid, ppid| yield pid, ppid }
      else
        each_ps_process { |pid, ppid| yield pid, ppid }
      end
    end

    def each_proc_process
      Dir.glob('/proc/[0-9]*/stat').each do |path|
        stat = begin
          File.read(path)
        rescue SystemCallError, IOError
          next
        end
        # "pid (comm) state ppid ..." -- comm may contain spaces and ')'.
        tail = stat[(stat.rindex(') ') || -2) + 2, stat.length].to_s.split
        pid = File.basename(File.dirname(path)).to_i
        ppid = tail[1].to_i
        yield pid, ppid if pid.positive? && ppid.positive?
      end
    end

    def each_ps_process
      out, status = Open3.capture2e('ps', '-eo', 'pid=,ppid=')
      return unless status.success?

      out.each_line do |line|
        pid, ppid = line.split.map(&:to_i)
        yield pid, ppid if pid&.positive? && ppid&.positive?
      end
    rescue SystemCallError
      nil
    end

    def close_input
      @stdin.close unless @stdin.closed?
    rescue IOError
      nil
    end

    def new_token
      "REPL-#{SecureRandom.hex(8)}"
    end

    # Wait for the kernel to become ready and swallow its banner.
    def sync_startup
      if @marker
        token = new_token
        @stdin.puts(format(@marker, token))
        @stdin.flush
        read_answer(token)
      elsif @prompt
        read_answer(nil)
      else
        drain(@wait_timeout)
      end
    end

    def read_answer(token)
      if token
        answer = read_while { |buf| buf.lines.any? { |l| l.strip == token } }
        discard_pending(MARKER_GRACE) # the marker line's own return value
        answer
      elsif @prompt
        read_while { |buf| @prompt.match?(buf.lines.last.to_s) }
      else
        drain(@wait_timeout)
      end
    end

    # Throw away output left over from a previous command.
    def discard_pending(timeout = 0)
      drain_loop(timeout, timeout) { }
    end

    # Read until the block says we are done (or the kernel goes quiet for
    # @timeout seconds).
    def read_while(&done)
      buffer = +''
      drain_loop(@timeout, @timeout) do |chunk|
        buffer << chunk
        break if done.call(buffer)
      end
      buffer
    end

    # Read until the kernel is silent for @idle_timeout seconds.
    def drain(first_wait)
      buffer = +''
      drain_loop(first_wait, @idle_timeout) { |chunk| buffer << chunk }
      buffer
    end

    def drain_loop(first_wait, next_wait)
      timeout = first_wait
      loop do
        break unless IO.select([@stdout], nil, nil, timeout)

        chunk = read_chunk
        break if chunk.nil?

        yield chunk
        timeout = next_wait
      end
    end

    def read_chunk
      @stdout.read_nonblock(4096)
    rescue IO::WaitReadable
      ''
    rescue EOFError, Errno::EIO, IOError
      nil
    end

    # Remove terminal noise: echoed input, marker lines and prompts.
    def clean(raw, command_text, token)
      lines = raw.to_s.gsub("\r\n", "\n").delete("\r").split("\n", -1)
      if token
        stop = lines.index { |l| l.strip == token }
        lines = lines[0...stop] if stop
        lines.reject! { |l| l.include?(token) }
      end
      lines = lines.map { |l| l.sub(@prompt, '') } if @prompt
      drop_echo(lines, command_text)
      lines.shift while lines.first&.strip&.empty?
      lines.pop while lines.last&.strip&.empty?
      lines.join("\n")
    end

    # REPLs reading from a pipe usually echo the input back -- but not all of
    # them do, so a line is only treated as an echo when the kernel is known to
    # echo, or when real output follows it.
    def drop_echo(lines, command_text)
      command_text.split("\n").each do |sent|
        sent = sent.strip
        next if sent.empty?

        first = lines.first&.strip
        next unless first && (first == sent || first.end_with?(sent))
        next unless @echo || lines.drop(1).any? { |l| !l.strip.empty? }

        lines.shift
        @echo = true
      end
    end
  end

  # Input preprocessing and output crafting for `repl editor-send`.
  #
  # The input is a piece of an editor buffer: possibly wrapped in a markdown
  # code fence and interleaved with output blocks that open with '#=>' and
  # close with '#==' (or with the first line that is not a comment). The text
  # is echoed back with every output block replaced by a fresh answer, so the
  # editor can substitute the region it fed in with the result.
  module Editor
    OPEN  = '#=>'
    CLOSE = '#=='
    FENCE = /\A\s*```/.freeze

    # One command plus the flag telling whether its output is shown.
    Chunk = Struct.new(:code, :block) do
      def command
        code.join("\n").strip
      end
    end

    Document = Struct.new(:head, :chunks, :tail)

    # Parse, run every chunk through the given block, and return the crafted
    # text.
    def self.run(text)
      document = parse(text)
      outputs = document.chunks.map do |chunk|
        command = chunk.command
        command.empty? ? '' : yield(command)
      end
      render(document, outputs)
    end

    # Splits the text on '#=>' markers; stale output blocks are dropped. The
    # markdown fences are kept aside, out of the way of the kernel.
    def self.parse(text)
      lines = text.to_s.gsub("\r\n", "\n").delete("\r").split("\n", -1)
      head, tail = split_fences(lines)
      chunks = []
      code = []
      index = 0
      while index < lines.size
        if lines[index].strip == OPEN
          index = skip_block(lines, index + 1)
          chunks << Chunk.new(code, true)
          code = []
        else
          code << lines[index]
          index += 1
        end
      end
      chunks << Chunk.new(code, false) unless code.empty? && !chunks.empty?
      chunks << Chunk.new([], true) if chunks.empty?
      # Without any marker the answer of the last (only) command is appended.
      chunks.last.block = true if chunks.none?(&:block)
      Document.new(head, chunks, tail)
    end

    def self.render(document, outputs)
      lines = document.head.dup
      document.chunks.each_with_index do |chunk, i|
        code = chunk.code.dup
        # Blank lines at the end of the code belong after the block.
        blanks = chunk.block ? pop_blanks(code) : []
        lines.concat(code)
        lines.concat(block(outputs[i])) if chunk.block
        lines.concat(blanks)
      end
      lines.concat(document.tail)
      lines.join("\n")
    end

    def self.pop_blanks(code)
      blanks = []
      blanks.unshift(code.pop) while !code.empty? && code.last.strip.empty?
      blanks
    end

    # An output block: the markers plus the answer, one '# ' per line.
    def self.block(output)
      [OPEN, *comment(output), CLOSE]
    end

    def self.comment(output)
      output.to_s.split("\n").map { |line| line.empty? ? '#' : "# #{line}" }
    end

    # Take a leading and/or trailing markdown fence off the code.
    def self.split_fences(lines)
      head = []
      tail = []
      first = lines.index { |l| !l.strip.empty? }
      head = lines.shift(first + 1) if first && FENCE.match?(lines[first])
      last = lines.rindex { |l| !l.strip.empty? }
      tail = lines.slice!(last..-1) if last && FENCE.match?(lines[last])
      [head, tail]
    end

    # Skip the previous output of a block, i.e. comment lines up to a '#=='
    # terminator or up to the first line that is not a comment.
    def self.skip_block(lines, index)
      while index < lines.size
        line = lines[index].strip
        return index + 1 if line == CLOSE
        return index unless line.start_with?('#') || line.empty?

        # Blank lines belong to the block only when '#==' still follows.
        if line.empty?
          nxt = index
          nxt += 1 while nxt < lines.size && lines[nxt].strip.empty?
          return lines[nxt]&.strip == CLOSE ? nxt + 1 : index
        end
        index += 1
      end
      index
    end
  end

  # Ring buffer of recent exchanges plus traffic counters.
  class History
    Entry = Struct.new(:time, :input, :output)

    attr_reader :limit, :started_at

    def initialize(limit = DEFAULT_HISTORY)
      @limit = limit
      @entries = []
      @requests = 0
      @in_bytes = 0
      @out_bytes = 0
      @started_at = Time.now
      @mutex = Mutex.new
    end

    def record(input, output)
      @mutex.synchronize do
        @entries << Entry.new(Time.now, input.to_s, output.to_s)
        @entries.shift while @entries.size > @limit
        @requests += 1
        @in_bytes += input.to_s.bytesize
        @out_bytes += output.to_s.bytesize
      end
    end

    def size
      @mutex.synchronize { @entries.size }
    end

    def tail(count = 10)
      @mutex.synchronize { @entries.last([count, 0].max) }
    end

    def stats
      @mutex.synchronize do
        { requests: @requests, in_bytes: @in_bytes, out_bytes: @out_bytes,
          stored: @entries.size, started_at: @started_at,
          uptime: Time.now - @started_at }
      end
    end
  end

  # Keeps track of running servers so that `repl send` needs no arguments when
  # there is only one of them.
  class Registry
    def initialize(path = self.class.default_path)
      @path = path
    end

    attr_reader :path

    def self.default_path
      home = ENV['REPL_HOME'] || File.join(Dir.home, '.repl')
      File.join(home, 'servers.json')
    end

    def register(socket:, pid:, command:)
      update do |entries|
        entries.reject! { |e| e['socket'] == socket }
        entries << { 'socket' => socket, 'pid' => pid,
                     'command' => Array(command).join(' '),
                     'started_at' => Time.now.to_i }
      end
    end

    def unregister(socket)
      update { |entries| entries.reject! { |e| e['socket'] == socket } }
    end

    # Live servers only; stale entries are pruned on read.
    def servers
      update { |entries| entries.select! { |e| live?(e) } }
    end

    private

    def live?(entry)
      return false unless File.socket?(entry['socket'].to_s)

      Process.kill(0, entry['pid'].to_i)
      true
    rescue Errno::ESRCH, Errno::EPERM, TypeError
      false
    end

    def update
      FileUtils.mkdir_p(File.dirname(@path))
      File.open(@path, File::RDWR | File::CREAT, 0o600) do |f|
        f.flock(File::LOCK_EX)
        entries = JSON.parse(f.read) rescue []
        entries = [] unless entries.is_a?(Array)
        yield entries
        f.rewind
        f.truncate(0)
        f.write(JSON.pretty_generate(entries))
        entries
      end
    end
  end

  # Sends a single request to a server and returns its output.
  class Client
    def self.call(socket_path, input)
      request(socket_path, 'cmd' => input.to_s)
    end

    def self.post(socket_path, input)
      request(socket_path, 'post' => input.to_s)
    end

    def self.signal(socket_path, name)
      request(socket_path, 'signal' => name.to_s)
    end

    def self.request(socket_path, payload)
      raise Error, "no server socket at '#{socket_path}'" unless File.socket?(socket_path.to_s)

      UNIXSocket.open(socket_path) do |sock|
        sock.puts(JSON.generate(payload))
        line = sock.gets
        raise Error, 'server closed the connection without answering' unless line

        response = JSON.parse(line)
        raise Error, response['error'] if response['error']

        response['out'].to_s
      end
    rescue Errno::ECONNREFUSED, Errno::ENOENT
      raise Error, "cannot connect to '#{socket_path}'"
    end
  end

  # Accepts client connections on a UNIX socket and serves the admin console.
  class Server
    ADMIN_HELP = <<~HELP.freeze
      admin commands:
        tail [n]          show latest messages (default 10)
        stats             show input/output statistics
        post COMMAND      send COMMAND to the kernel without waiting for output
        attach [COMMAND]  talk to the kernel: run COMMAND once, or without
                          arguments enter attached mode ('detach' to leave;
                          Ctrl-C is forwarded to the kernel)
        signal [NAME]     send a signal or control character to the kernel
                          (default INT); e.g. signal ^C, signal TSTP
        interrupt         alias for `signal INT`
        eof               close the kernel's input (Ctrl-D)
        close, quit       stop the server
        help              this text
    HELP

    attr_reader :socket_path, :history, :backend

    def initialize(backend, socket_path: nil, registry: Registry.new,
                   history: History.new, out: $stdout, prompt: '> ')
      @backend = backend
      @socket_path = socket_path || self.class.generate_socket_path
      @registry = registry
      @history = history
      @out = out
      @prompt = prompt
      @mutex = Mutex.new
      @running = false
      @stopped = false
      @attached = false
    end

    def self.generate_socket_path
      name = (0...7).map { ('A'..'Z').to_a.sample }.join
      File.join(Dir.tmpdir, "repl-kernel-#{name}")
    end

    def start
      FileUtils.rm_f(@socket_path)
      FileUtils.mkdir_p(File.dirname(@socket_path))
      @server = UNIXServer.new(@socket_path)
      File.chmod(0o600, @socket_path)
      @registry.register(socket: @socket_path, pid: Process.pid,
                         command: @backend.command)
      @running = true
      @acceptor = Thread.new { accept_loop }
      self
    end

    def running?
      @running
    end

    def stop
      return self if @stopped

      @stopped = true
      @running = false
      begin
        @server&.close
      rescue IOError
        nil
      end
      @acceptor&.join(1)
      FileUtils.rm_f(@socket_path)
      @registry.unregister(@socket_path)
      @backend.close
      self
    end

    # Runs the admin console; returns when the user asks the server to stop.
    def run_admin(input = $stdin)
      loop do
        @out.print(@prompt)
        @out.flush
        line = input.gets
        break unless line

        text, action = admin_command(line)
        @out.puts(text) if text
        break if action == :stop
        run_attached(input) if action == :attach
      end
      stop
    end

    # Attached mode: every line goes to the kernel until 'detach' or EOF.
    def run_attached(input = $stdin)
      @attached = true
      loop do
        @out.print(attach_prompt)
        @out.flush
        line = input.gets
        break unless line

        break if %w[detach .].include?(line.strip)
        next if line.strip.empty?

        @out.puts(run_kernel_command(line))
      end
      @out.puts('detached')
    ensure
      @attached = false
    end

    def attached?
      @attached
    end

    # In attached mode the console stands in for the kernel's terminal, so
    # Ctrl-C must reach the kernel instead of stopping the server. Returns
    # true when the interrupt was forwarded. Runs in a signal handler, so it
    # must stay lock free (no history recording).
    def forward_interrupt
      return false unless @attached && @backend.alive?

      @backend.signal('INT')
      true
    rescue Error, SystemCallError
      false
    end

    def attach_prompt
      "#{File.basename(@backend.command.first)}#{@prompt}"
    end

    # Returns [output, action] where action is nil, :stop or :attach.
    def admin_command(line)
      name, arg = line.to_s.strip.split(/\s+/, 2)
      case name
      when nil, '' then [nil, nil]
      when 'close', 'quit', 'exit' then ['stopping', :stop]
      when 'stats' then [format_stats, nil]
      when 'tail' then [format_tail(arg.nil? ? 10 : arg.to_i), nil]
      when 'post' then [safely { post(arg.to_s) }, nil]
      when 'attach' then arg ? [run_kernel_command(arg), nil] : [nil, :attach]
      when 'signal' then [safely { signal(arg || 'INT') }, nil]
      when 'interrupt', 'int' then [safely { signal('INT') }, nil]
      when 'eof' then [safely { signal('EOF') }, nil]
      when 'help', '?' then [ADMIN_HELP, nil]
      else ["unknown command '#{name}' (try help)", nil]
      end
    end

    # Executes a command on the kernel and records it. Safe to call from
    # several connection threads.
    def execute(input)
      output = @mutex.synchronize { @backend.execute(input) }
      @history.record(input, output)
      output
    end

    # Signals are delivered without taking the kernel lock, so they can
    # interrupt a command that is still running.
    # Posts go straight to the kernel's input without taking the kernel lock,
    # so they never wait for an answer and can also feed a command that is
    # still running.
    def post(input)
      @backend.post(input)
      text = 'posted'
      @history.record(input, text)
      text
    end

    def signal(name)
      sent = @backend.signal(name)
      text = sent == 'EOF' ? 'closed kernel input (EOF)' : "sent SIG#{sent} to pid #{@backend.pid}"
      @history.record("<signal #{name}>", text)
      text
    end

    private

    def run_kernel_command(line)
      output = execute(line)
      output.empty? ? '(no output)' : output
    rescue Error => e
      "error: #{e.message}"
    end

    def safely
      yield
    rescue Error => e
      "error: #{e.message}"
    end

    def accept_loop
      while @running
        begin
          conn = @server.accept
        rescue IOError, Errno::EBADF, Errno::EINVAL
          break
        end
        Thread.new(conn) { |c| serve(c) }
      end
    end

    def serve(conn)
      while (line = conn.gets)
        conn.puts(JSON.generate(handle_request(line)))
      end
    rescue Errno::EPIPE, IOError
      nil
    ensure
      begin
        conn.close
      rescue IOError
        nil
      end
    end

    def handle_request(line)
      request = JSON.parse(line)
      raise Error, 'malformed request: not an object' unless request.is_a?(Hash)

      if request.key?('cmd')
        { 'out' => execute(request['cmd']) }
      elsif request.key?('post')
        { 'out' => post(request['post']) }
      elsif request.key?('signal')
        { 'out' => signal(request['signal']) }
      else
        raise Error, 'malformed request: "cmd" is missing'
      end
    rescue JSON::ParserError
      { 'error' => 'malformed request: invalid JSON' }
    rescue Error => e
      { 'error' => e.message }
    end

    def format_stats
      s = @history.stats
      format("socket:   %s\nkernel:   %s (pid %d, %s)\nuptime:   %.1fs\nrequests: %d\nin:       %d bytes\nout:      %d bytes",
             @socket_path, @backend.command.join(' '), @backend.pid,
             @backend.alive? ? 'running' : 'dead', s[:uptime], s[:requests],
             s[:in_bytes], s[:out_bytes])
    end

    def format_tail(count)
      entries = @history.tail(count)
      return '(no messages yet)' if entries.empty?

      entries.map do |e|
        "[#{e.time.strftime('%H:%M:%S')}] < #{one_line(e.input)}\n" \
          "           > #{one_line(e.output)}"
      end.join("\n")
    end

    def one_line(text)
      flat = text.to_s.strip.gsub(/\s*\n\s*/, ' ⏎ ')
      flat.length > 100 ? "#{flat[0, 97]}..." : flat
    end
  end

  # Command line front end.
  class CLI
    USAGE = <<~TEXT.freeze
      Usage:
        repl kernel [options] COMMAND [ARGS...]   start a REPL server
        repl send [options] [TEXT...]             send a command (stdin if no TEXT)
        repl post [options] [TEXT...]             send a command, expect no answer
        repl editor-send [options] [TEXT...]      send an editor region and craft
                                                  its output back
        repl signal [options] [NAME]              signal the kernel (default INT)
        repl list                                 list running servers
        repl version | help

      kernel options:
        --socket PATH      socket to listen on (default: /tmp/repl-kernel-XXXXXXX)
        --marker TEMPLATE  printf template making the kernel echo a token,
                           e.g. --marker 'puts "%s"' (most reliable)
        --prompt REGEX     regex matching the kernel prompt
        --idle SECONDS     silence marking the end of an answer (default 0.3)
        --wait SECONDS     wait for the first byte of an answer (default 2.0)
        --timeout SECONDS  inactivity limit in marker/prompt mode (default 30)
        --history N        number of messages kept for `tail` (default 100)

      send/post/editor-send/signal options:
        --socket PATH      server socket; defaults to $REPL_SOCKET or to the
                           only running server

      signal names: INT, TSTP, CONT, TERM, ... or control characters such as
      ^C, ^Z, ^D (EOF closes the kernel's input).
    TEXT

    def initialize(argv, out: $stdout, err: $stderr, stdin: $stdin,
                   registry: Registry.new)
      @argv = argv.dup
      @out = out
      @err = err
      @stdin = stdin
      @registry = registry
    end

    def run
      command = @argv.shift
      case command
      when 'kernel' then cmd_kernel(@argv)
      when 'send' then cmd_send(@argv)
      when 'post' then cmd_post(@argv)
      when 'editor-send' then cmd_editor_send(@argv)
      when 'signal' then cmd_signal(@argv)
      when 'list' then cmd_list
      when 'version', '--version', '-v' then @out.puts("repl #{VERSION}") || 0
      when nil, 'help', '--help', '-h' then @out.puts(USAGE) || 0
      else
        @err.puts("unknown command '#{command}'\n\n#{USAGE}")
        1
      end
    rescue Error => e
      @err.puts("repl: #{e.message}")
      1
    end

    # Resolution order: --socket, $REPL_SOCKET, the only running server.
    def resolve_socket(explicit = nil)
      return explicit if explicit && !explicit.empty?

      from_env = ENV['REPL_SOCKET']
      return from_env if from_env && !from_env.empty?

      servers = @registry.servers
      raise Error, 'no running server found; start one with `repl kernel CMD`' if servers.empty?

      if servers.size > 1
        list = servers.map { |s| "  #{s['socket']}  (#{s['command']})" }.join("\n")
        raise Error, "several servers are running, use --socket:\n#{list}"
      end
      servers.first['socket']
    end

    private

    def cmd_kernel(argv)
      options = { history: DEFAULT_HISTORY, idle: DEFAULT_IDLE_TIMEOUT,
                  wait: DEFAULT_WAIT_TIMEOUT, timeout: DEFAULT_TIMEOUT }
      parser = OptionParser.new do |o|
        o.on('--socket PATH') { |v| options[:socket] = v }
        o.on('--marker TEMPLATE') { |v| options[:marker] = v }
        o.on('--prompt REGEX') { |v| options[:prompt] = v }
        o.on('--idle SECONDS', Float) { |v| options[:idle] = v }
        o.on('--wait SECONDS', Float) { |v| options[:wait] = v }
        o.on('--timeout SECONDS', Float) { |v| options[:timeout] = v }
        o.on('--history N', Integer) { |v| options[:history] = v }
        o.on('-h', '--help') { options[:help] = true }
      end
      command = parser.order(argv)
      return (@out.puts(USAGE) || 0) if options[:help]
      raise Error, "kernel command is required\n\n#{USAGE}" if command.empty?

      backend = Backend.new(command, idle_timeout: options[:idle],
                                     wait_timeout: options[:wait],
                                     timeout: options[:timeout],
                                     prompt: options[:prompt],
                                     marker: options[:marker])
      server = Server.new(backend, socket_path: options[:socket],
                                   registry: @registry,
                                   history: History.new(options[:history]),
                                   out: @out)
      server.start
      @out.puts("Starting kernel '#{command.join(' ')}' on socket '#{server.socket_path}'")
      trap('INT') do
        next if server.forward_interrupt

        server.stop
        exit 0
      end
      trap('TERM') { server.stop; exit 0 }
      server.run_admin(@stdin)
      0
    end

    def cmd_send(argv)
      input, options = read_input(argv)
      return 0 unless input

      output = Client.call(resolve_socket(options[:socket]), input)
      @out.puts(output) unless output.empty?
      0
    end

    def cmd_post(argv)
      input, options = read_input(argv)
      return 0 unless input

      Client.post(resolve_socket(options[:socket]), input)
      0
    end

    def cmd_editor_send(argv)
      input, options = read_input(argv)
      return 0 unless input

      socket = resolve_socket(options[:socket])
      @out.puts(Editor.run(input) { |command| Client.call(socket, command) })
      0
    end

    # Shared front end of send/post/editor-send: options, then TEXT or stdin.
    def read_input(argv)
      options = {}
      parser = OptionParser.new do |o|
        o.on('--socket PATH') { |v| options[:socket] = v }
        o.on('-h', '--help') { options[:help] = true }
      end
      rest = parser.order(argv)
      if options[:help]
        @out.puts(USAGE)
        return [nil, nil]
      end

      input = rest.empty? ? @stdin.read : rest.join(' ')
      raise Error, 'nothing to send' if input.to_s.strip.empty?

      [input, options]
    end

    def cmd_signal(argv)
      options = {}
      parser = OptionParser.new do |o|
        o.on('--socket PATH') { |v| options[:socket] = v }
        o.on('-h', '--help') { options[:help] = true }
      end
      rest = parser.order(argv)
      return (@out.puts(USAGE) || 0) if options[:help]

      name = rest.first || 'INT'
      @out.puts(Client.signal(resolve_socket(options[:socket]), name))
      0
    end

    def cmd_list
      servers = @registry.servers
      if servers.empty?
        @out.puts('no running servers')
      else
        servers.each { |s| @out.puts("#{s['socket']}\t#{s['command']}\tpid #{s['pid']}") }
      end
      0
    end
  end
end

exit(Repl::CLI.new(ARGV).run) if $PROGRAM_NAME == __FILE__
